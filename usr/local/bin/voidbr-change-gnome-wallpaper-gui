class JanelaWallpaper(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=APP_NAME)
        self.set_default_size(640, -1)

        self.linhas_conf = []
        self.salvo = None
        self.fundo = None
        self.pasta = PASTA_PADRAO
        self.pasta_exibida = None  # pasta cujas miniaturas estão na grade
        self.id_carga = 0          # idle que carrega as miniaturas
        self.wallpapers = []
        self.caminho_fixo = ""
        self.miniaturas = {}  # caminho -> FlowBoxChild
        self.carregando = False

        # --- CSS ---
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # --- Barra de título com menu ---
        cabecalho = Gtk.HeaderBar()
        cabecalho.add_css_class("cabecalho-app")
        self.set_titlebar(cabecalho)

        menu = Gio.Menu()
        menu.append("🔄 Recarregar configuração", "win.recarregar")
        menu.append("ℹ️ Sobre / Créditos", "win.sobre")
        botao_menu = Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu)
        botao_menu.add_css_class("botao-menu")
        cabecalho.pack_end(botao_menu)

        for nome, cb in (("recarregar", lambda *_: self.carregar()),
                         ("sobre", self.ao_clicar_sobre)):
            acao = Gio.SimpleAction.new(nome, None)
            acao.connect("activate", cb)
            self.add_action(acao)

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                        margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
        self.set_child(caixa)

        # --- Título ---
        titulo = Gtk.Label(label="🖼️ voidbr-change-gnome-wallpaper", xalign=0)
        titulo.add_css_class("titulo-app")
        caixa.append(titulo)

        # --- Aviso ---
        self.caixa_alerta = Gtk.Box(spacing=10)
        self.caixa_alerta.add_css_class("caixa-alerta")
        self.label_alerta = Gtk.Label(xalign=0, hexpand=True, wrap=True)
        self.caixa_alerta.append(self.label_alerta)
        self.caixa_alerta.set_visible(False)
        caixa.append(self.caixa_alerta)

        # --- Wallpaper atual ---
        self.label_atual = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.label_atual.add_css_class("subtitulo")
        caixa.append(self.label_atual)

        # ScrolledWindow sem barras só para travar a altura: o Gtk.Picture
        # sozinho cresce conforme a proporção da imagem
        previa = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                    vscrollbar_policy=Gtk.PolicyType.NEVER)
        previa.set_size_request(-1, 170)
        previa.add_css_class("caixa-previa")
        self.imagem = Gtk.Picture(can_shrink=True)
        if hasattr(self.imagem, "set_content_fit"):
            self.imagem.set_content_fit(Gtk.ContentFit.COVER)
        previa.set_child(self.imagem)
        caixa.append(previa)

        # --- Configuração ---
        grade = Gtk.Grid(column_spacing=12, row_spacing=10)
        caixa.append(grade)

        grade.attach(Gtk.Label(label="🎛️ Modo:", xalign=0), 0, 0, 1, 1)
        self.lista_modo = Gtk.DropDown.new_from_strings([r for r, _ in MODOS])
        self.lista_modo.set_hexpand(True)
        self.lista_modo.connect("notify::selected", self.ao_mudar_modo)
        grade.attach(self.lista_modo, 1, 0, 1, 1)

        # linha que muda conforme o modo (mesma altura nos três)
        self.pilha = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        grade.attach(self.pilha, 0, 1, 2, 1)

        linha_slide = Gtk.Box(spacing=8)
        linha_slide.append(Gtk.Label(label="⏱️ Trocar a cada:", xalign=0, hexpand=True))
        self.spin = Gtk.SpinButton.new_with_range(1, 99999, 1)
        self.spin.connect("value-changed", self.ao_mudar)
        self.lista_unidade = Gtk.DropDown.new_from_strings([u for u, _ in UNIDADES])
        self.lista_unidade.connect("notify::selected", self.ao_mudar)
        linha_slide.append(self.spin)
        linha_slide.append(self.lista_unidade)
        self.pilha.add_named(linha_slide, "slide")

        linha_fixo = Gtk.Box(spacing=8)
        linha_fixo.append(Gtk.Label(label="📌 Wallpaper:", xalign=0))
        self.label_fixo = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.START)
        self.label_fixo.add_css_class("texto-apagado")
        linha_fixo.append(self.label_fixo)
        linha_fixo.append(self._botao("📂 Outro arquivo…", "botao-azul", self.ao_clicar_escolher))
        self.pilha.add_named(linha_fixo, "fixo")

        linha_off = Gtk.Box()
        aviso_off = Gtk.Label(xalign=0, hexpand=True, wrap=True, label=(
            "⏸️ O timer continua rodando, mas não troca o wallpaper."))
        aviso_off.add_css_class("texto-apagado")
        linha_off.append(aviso_off)
        self.pilha.add_named(linha_off, "off")

        # --- Miniaturas ---
        linha_titulo = Gtk.Box(spacing=8)
        self.label_grade = Gtk.Label(xalign=0, hexpand=True)
        self.label_grade.add_css_class("subtitulo")
        self.label_pasta = Gtk.Label(xalign=1, selectable=True, ellipsize=Pango.EllipsizeMode.START)
        self.label_pasta.add_css_class("texto-apagado")
        self.botao_pasta = self._botao("📁 Pasta…", "botao-azul", self.ao_clicar_pasta)
        self.botao_pasta.set_tooltip_text("Escolher a pasta dos wallpapers")
        linha_titulo.append(self.label_grade)
        linha_titulo.append(self.label_pasta)
        linha_titulo.append(self.botao_pasta)
        caixa.append(linha_titulo)

        rolagem = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        rolagem.set_size_request(-1, 180)
        rolagem.add_css_class("lista-wallpapers")
        self.grade_mini = Gtk.FlowBox(
            selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
            max_children_per_line=8, min_children_per_line=2,
            row_spacing=4, column_spacing=4, valign=Gtk.Align.START,
            margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        self.grade_mini.connect("selected-children-changed", self.ao_selecionar_miniatura)
        rolagem.set_child(self.grade_mini)
        self.rolagem_mini = rolagem
        caixa.append(rolagem)

        # --- Status ---
        caixa_status = Gtk.Box()
        caixa_status.add_css_class("caixa-status")
        self.label_status = Gtk.Label(label="⏳ Carregando…", xalign=0, hexpand=True, wrap=True)
        caixa_status.append(self.label_status)
        caixa.append(caixa_status)

        # --- Ações ---
        linha_acoes = Gtk.Box(spacing=8, homogeneous=True)
        self.botao_proximo = self._botao("⏭️ Próximo", "botao-laranja", self.ao_clicar_proximo)
        self.botao_padrao = self._botao("♻️ Padrão", "botao-azul", self.ao_clicar_padrao)
        self.botao_salvar = self._botao("💾 Salvar", "botao-verde", self.ao_clicar_salvar)
        for b in (self.botao_proximo, self.botao_padrao, self.botao_salvar):
            linha_acoes.append(b)
        caixa.append(linha_acoes)

        # --- Fechar ---
        caixa.append(self._botao("🚪 Fechar", "botao-cinza", lambda *_: self.close()))

        self.configurar_gsettings()
        self.carregar()

    # -- helpers de construção ---------------------------------------------

    def _botao(self, texto, classe, cb):
        b = Gtk.Button(label=texto)
        b.add_css_class(classe)
        b.connect("clicked", cb)
        return b

    # -- dados -------------------------------------------------------------

    def configurar_gsettings(self):
        fonte = Gio.SettingsSchemaSource.get_default()
        if fonte and fonte.lookup(ESQUEMA_FUNDO, True):
            self.fundo = Gio.Settings.new(ESQUEMA_FUNDO)
            for chave in ("picture-uri", "picture-uri-dark"):
                self.fundo.connect(f"changed::{chave}", lambda *_: self.atualizar_previa())

    def wallpaper_atual(self):
        if not self.fundo:
            return None
        uri = self.fundo.get_string("picture-uri-dark") or self.fundo.get_string("picture-uri")
        if not uri:
            return None
        return unquote(urlparse(uri).path) if uri.startswith("file://") else uri

    def atualizar_previa(self):
        caminho = self.wallpaper_atual()
        if caminho and os.path.isfile(caminho):
            self.imagem.set_filename(caminho)
            self.label_atual.set_text(f"🖥️ Wallpaper atual: {os.path.basename(caminho)}")
        else:
            self.imagem.set_paintable(None)
            self.label_atual.set_text("🖥️ Wallpaper atual: (não foi possível ler do GNOME)")

    def preencher_miniaturas(self):
        """(Re)cria a grade de miniaturas da self.pasta e carrega as imagens aos poucos."""
        if self.id_carga:
            GLib.source_remove(self.id_carga)
            self.id_carga = 0
        while (filho := self.grade_mini.get_first_child()) is not None:
            self.grade_mini.remove(filho)
        self.miniaturas.clear()

        self.pasta_exibida = self.pasta
        self.label_pasta.set_text(self.pasta)
        self.label_pasta.set_tooltip_text(self.pasta)
        self.wallpapers = listar_wallpapers(self.pasta)
        pendentes = []
        for caminho in self.wallpapers:
            img = Gtk.Picture(can_shrink=True)
            img.set_size_request(MINI_L, MINI_A)
            if hasattr(img, "set_content_fit"):
                img.set_content_fit(Gtk.ContentFit.COVER)
            img.add_css_class("miniatura")
            img.set_tooltip_text(os.path.basename(caminho))
            filho = Gtk.FlowBoxChild(child=img)
            filho.caminho = caminho
            self.grade_mini.append(filho)
            self.miniaturas[caminho] = filho
            pendentes.append((img, caminho))

        def proxima():
            if not pendentes:
                self.id_carga = 0
                return False
            img, caminho = pendentes.pop(0)
            tex = textura_miniatura(caminho)
            if tex:
                img.set_paintable(tex)
            return True

        if pendentes:
            self.id_carga = GLib.idle_add(proxima)

    def carregar(self):
        existe, cfg, linhas = ler_config()
        self.linhas_conf = linhas
        self.salvo = dict(cfg)

        self.pasta = cfg["WALLPAPER_DIR"]
        if self.pasta != self.pasta_exibida:
            self.preencher_miniaturas()

        self.carregando = True
        idx, valor = melhor_unidade(cfg["INTERVAL"])
        self.lista_unidade.set_selected(idx)
        self.spin.set_value(valor)
        self.definir_fixo(cfg["FIXED_WALLPAPER"])
        if cfg["DISABLED"] == "yes":
            modo = "off"
        elif cfg["FIXED_WALLPAPER"]:
            modo = "fixo"
        else:
            modo = "slide"
        self.lista_modo.set_selected([c for _, c in MODOS].index(modo))
        self.carregando = False

        avisos = []
        if not existe:
            avisos.append(f"⚠️ <b>{GLib.markup_escape_text(CONFIG)} não existe.</b>\n"
                          "Sem ele o timer encerra o slideshow. Ele será criado ao salvar.")
        if cfg["FIXED_WALLPAPER"] and not os.path.isfile(cfg["FIXED_WALLPAPER"]):
            avisos.append("⚠️ <b>O wallpaper fixo configurado não existe mais.</b>\n"
                          "Enquanto isso, o timer está usando o slideshow.")
        aviso_pasta = self.aviso_pasta()
        if aviso_pasta:
            avisos.append(aviso_pasta)
        self.label_alerta.set_markup("\n".join(avisos))
        self.caixa_alerta.set_visible(bool(avisos))

        self.atualizar_previa()
        self.ao_mudar_modo()

    def definir_fixo(self, caminho):
        self.caminho_fixo = caminho
        self.label_fixo.set_text(caminho or "nenhum escolhido")
        self.label_fixo.set_tooltip_text(caminho or None)
        self.sincronizar_selecao()

    def sincronizar_selecao(self):
        """Só marca miniatura no modo fixo; nos outros a grade é só visual."""
        filho = self.miniaturas.get(self.caminho_fixo)
        if self.modo() == "fixo" and filho:
            self.grade_mini.select_child(filho)
        else:
            self.grade_mini.unselect_all()

    def modo(self):
        return MODOS[self.lista_modo.get_selected()][1]

    def valores_atuais(self):
        modo = self.modo()
        if modo == "off":
            # desativado: mantém o wallpaper fixo que já estava salvo
            fixo = self.salvo["FIXED_WALLPAPER"] if self.salvo else ""
        else:
            fixo = self.caminho_fixo if modo == "fixo" else ""
        return {
            "WALLPAPER_DIR": self.pasta,
            "INTERVAL": self.spin.get_value_as_int() * UNIDADES[self.lista_unidade.get_selected()][1],
            "DISABLED": "yes" if modo == "off" else "no",
            "FIXED_WALLPAPER": fixo,
        }

    # -- interface ---------------------------------------------------------

    def ao_mudar_modo(self, *_):
        modo = self.modo()
        self.pilha.set_visible_child_name(modo)
        n = len(self.wallpapers)
        if modo == "fixo":
            self.grade_mini.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.label_grade.set_text("🗂️ Escolha o wallpaper fixo:")
        else:
            self.grade_mini.set_selection_mode(Gtk.SelectionMode.NONE)
            self.label_grade.set_text(f"🗂️ {n} wallpaper{'s' if n != 1 else ''} na pasta:")
        self.rolagem_mini.set_sensitive(modo != "off")
        self.botao_pasta.set_sensitive(modo != "off")
        self.sincronizar_selecao()
        self.ao_mudar()

    def ao_mudar(self, *_):
        if self.carregando:
            return
        modo = self.modo()
        vals = self.valores_atuais()
        valido = not (modo == "fixo" and not self.caminho_fixo)
        mudou = vals != self.salvo or not os.path.isfile(CONFIG)
        self.botao_salvar.set_sensitive(valido and mudou)
        self.botao_proximo.set_sensitive(
            modo == "slide" and self.fundo is not None
            # o script usa a pasta salva: com outra pasta na tela, o "Próximo" confundiria
            and self.pasta == (self.salvo or {}).get("WALLPAPER_DIR")
            and os.access(CLI, os.X_OK) and bool(self.wallpapers))
        self.atualizar_status(mudou)

    def atualizar_status(self, mudou=False):
        esc = GLib.markup_escape_text
        rodando = timer_rodando()
        partes = [
            "<span foreground='#34d399' weight='bold'>✅ timer rodando</span>" if rodando
            else "<span foreground='#f87171' weight='bold'>❌ timer parado</span>",
        ]
        s = self.salvo or {}
        if s.get("DISABLED") == "yes":
            partes.append("⏸️ desativado")
        elif s.get("FIXED_WALLPAPER"):
            partes.append(esc(f"📌 fixo: {os.path.basename(s['FIXED_WALLPAPER'])}"))
        else:
            partes.append(esc(f"🎞️ slideshow a cada {intervalo_legivel(s.get('INTERVAL', 0))}"))
        partes.append(esc(f"📁 {len(self.wallpapers)} wallpapers"))
        if mudou:
            partes.append("<span foreground='#fbbf24' weight='bold'>✏️ alterações não salvas</span>")
        self.label_status.set_markup("   •   ".join(partes))
        if not rodando:
            self.label_status.set_tooltip_text(
                "O timer é iniciado no login do GNOME (autostart). "
                "Saia e entre de novo na sessão para iniciá-lo.")
        else:
            self.label_status.set_tooltip_text(None)

    # -- diálogos ----------------------------------------------------------

    def erro(self, titulo, detalhe=""):
        d = Gtk.AlertDialog(message=f"❌ {titulo}", detail=detalhe, modal=True)
        d.show(self)

    # -- ações -------------------------------------------------------------

    def ao_selecionar_miniatura(self, grade):
        if self.carregando or self.modo() != "fixo":
            return
        sel = grade.get_selected_children()
        if sel and sel[0].caminho != self.caminho_fixo:
            self.definir_fixo(sel[0].caminho)
            self.ao_mudar()

    def ao_clicar_escolher(self, *_):
        filtro = Gtk.FileFilter()
        filtro.set_name("Imagens")
        filtro.add_pixbuf_formats()
        inicio = os.path.dirname(self.caminho_fixo) if self.caminho_fixo else self.pasta
        pasta_inicial = Gio.File.new_for_path(inicio) if os.path.isdir(inicio) else None

        if hasattr(Gtk, "FileDialog"):
            # API nova (GTK 4.10+), sem warnings de depreciação
            dialogo = Gtk.FileDialog(title="Selecione o wallpaper", modal=True)
            filtros = Gio.ListStore.new(Gtk.FileFilter)
            filtros.append(filtro)
            dialogo.set_filters(filtros)
            if pasta_inicial:
                dialogo.set_initial_folder(pasta_inicial)

            def resposta(dlg, res):
                try:
                    arquivo = dlg.open_finish(res)
                except GLib.Error:
                    return
                if arquivo and arquivo.get_path():
                    self.ao_escolher_arquivo(arquivo.get_path())
            dialogo.open(self, None, resposta)
        else:
            # Fallback para GTK4 mais antigo (< 4.10)
            dialogo = Gtk.FileChooserNative(title="Selecione o wallpaper", transient_for=self,
                                            action=Gtk.FileChooserAction.OPEN)
            dialogo.add_filter(filtro)
            if pasta_inicial:
                dialogo.set_current_folder(pasta_inicial)

            def resposta(dlg, r):
                if r == Gtk.ResponseType.ACCEPT and dlg.get_file():
                    self.ao_escolher_arquivo(dlg.get_file().get_path())
                dlg.destroy()
            dialogo.connect("response", resposta)
            dialogo.show()
            self._dialogo = dialogo  # mantém a referência viva

    def aviso_pasta(self):
        """Texto de aviso sobre a pasta atual, ou None se estiver tudo certo."""
        esc = GLib.markup_escape_text
        if not os.path.isdir(self.pasta):
            return f"⚠️ <b>A pasta {esc(self.pasta)} não existe.</b>"
        if not self.wallpapers:
            return f"⚠️ Nenhuma imagem em {esc(self.pasta)}."
        if self.pasta.startswith(os.path.expanduser("~") + os.sep):
            # o .conf é global, mas a pasta pode estar no $HOME de um usuário só
            return ("⚠️ A pasta está na sua pasta pessoal: outros usuários do sistema "
                    "não vão conseguir usá-la.")
        return None

    def trocar_pasta(self, caminho):
        self.pasta = caminho.rstrip("/") or "/"
        self.preencher_miniaturas()
        aviso = self.aviso_pasta()
        self.label_alerta.set_markup(aviso or "")
        self.caixa_alerta.set_visible(bool(aviso))
        self.ao_mudar_modo()

    def ao_clicar_pasta(self, *_):
        inicio = self.pasta if os.path.isdir(self.pasta) else PASTA_PADRAO
        pasta_inicial = Gio.File.new_for_path(inicio) if os.path.isdir(inicio) else None

        if hasattr(Gtk, "FileDialog"):
            # API nova (GTK 4.10+), sem warnings de depreciação
            dialogo = Gtk.FileDialog(title="Selecione a pasta dos wallpapers", modal=True)
            if pasta_inicial:
                dialogo.set_initial_folder(pasta_inicial)

            def resposta(dlg, res):
                try:
                    pasta = dlg.select_folder_finish(res)
                except GLib.Error:
                    return
                if pasta and pasta.get_path():
                    self.trocar_pasta(pasta.get_path())
            dialogo.select_folder(self, None, resposta)
        else:
            # Fallback para GTK4 mais antigo (< 4.10)
            dialogo = Gtk.FileChooserNative(title="Selecione a pasta dos wallpapers",
                                            transient_for=self,
                                            action=Gtk.FileChooserAction.SELECT_FOLDER)
            if pasta_inicial:
                dialogo.set_current_folder(pasta_inicial)

            def resposta(dlg, r):
                if r == Gtk.ResponseType.ACCEPT and dlg.get_file():
                    self.trocar_pasta(dlg.get_file().get_path())
                dlg.destroy()
            dialogo.connect("response", resposta)
            dialogo.show()
            self._dialogo = dialogo  # mantém a referência viva

    def ao_escolher_arquivo(self, caminho):
        self.definir_fixo(caminho)
        self.ao_mudar()
        # o .conf é global, mas a imagem pode estar no $HOME de um usuário só
        if caminho.startswith(os.path.expanduser("~") + os.sep):
            self.label_alerta.set_markup(
                "⚠️ A imagem está na sua pasta pessoal: outros usuários do sistema "
                "não vão conseguir usá-la.")
            self.caixa_alerta.set_visible(True)

    def ao_clicar_padrao(self, *_):
        if self.pasta != PASTA_PADRAO:
            self.trocar_pasta(PASTA_PADRAO)
        idx, valor = melhor_unidade(INTERVALO_PADRAO)
        self.lista_unidade.set_selected(idx)
        self.spin.set_value(valor)
        self.lista_modo.set_selected(0)

    def ao_clicar_salvar(self, *_):
        vals = self.valores_atuais()
        self.botao_salvar.set_sensitive(False)
        rc, err = gravar_config(montar_config(self.linhas_conf, vals))
        if rc in (126, 127) and os.geteuid() != 0:  # autenticação cancelada no pkexec
            self.ao_mudar()
            return
        if rc != 0:
            self.erro("Não foi possível salvar a configuração", err or f"código de saída {rc}")
            self.ao_mudar()
            return

        # wallpaper fixo: aplica já, sem esperar o próximo ciclo do timer
        if vals["DISABLED"] == "no" and vals["FIXED_WALLPAPER"]:
            self.executar_cli(vals["FIXED_WALLPAPER"])

        self.carregar()
        if vals["DISABLED"] == "yes":
            msg = "Troca automática desativada."
        elif vals["FIXED_WALLPAPER"]:
            msg = f"Wallpaper fixo: {os.path.basename(vals['FIXED_WALLPAPER'])}."
        else:
            msg = (f"Slideshow a cada {intervalo_legivel(vals['INTERVAL'])} "
                   "(vale a partir do próximo ciclo do timer).")
        self.label_status.set_markup(
            f"<span foreground='#34d399' weight='bold'>💾 Salvo!</span>   "
            f"{GLib.markup_escape_text(msg)}")

    def executar_cli(self, *args):
        try:
            subprocess.Popen([CLI, *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            self.erro(f"Não foi possível executar {CLI}", str(e))

    def ao_clicar_proximo(self, *_):
        self.executar_cli()

    def ao_clicar_sobre(self, *_):
        sobre = Gtk.AboutDialog()
        sobre.set_transient_for(self)
        sobre.set_modal(True)
        sobre.set_program_name(APP_NAME)
        sobre.set_version(APP_VERSION)
        sobre.set_logo_icon_name("preferences-desktop-wallpaper-symbolic")
        sobre.set_comments(
            "🖼️ Slideshow e wallpaper fixo para o GNOME, feito com Python + GTK4.\n"
            "Desenvolvido para o VoidBR Linux 🐧"
        )
        sobre.set_website("https://voidbr.org")
        sobre.set_website_label("VoidBR")
        sobre.set_authors(["Vilmar Catafesta <vcatafesta@gmail.com>"])
        sobre.set_copyright("© 2026 Vilmar Catafesta — Licença livre, use e modifique à vontade")
        sobre.set_license_type(Gtk.License.MIT_X11)
        sobre.present()


class AppWallpaper(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        janela = self.props.active_window
        if janela is None:
            janela = JanelaWallpaper(self)
            # fechar a janela principal encerra o app, mesmo que algo ainda
            # esteja segurando o GApplication (antes ficava pendurado no terminal)
            janela.connect("close-request", self.ao_fechar_janela)
        janela.present()

    def ao_fechar_janela(self, *_):
        self.quit()
        return False  # deixa a janela fechar normalmente


if __name__ == "__main__":
    # Ctrl+C no terminal: encerra na hora, sem traceback
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    app = AppWallpaper()
    sys.exit(app.run(None))
