CONFIG = "/etc/voidbr-change-gnome-wallpaper.conf"
CLI = "/usr/local/bin/voidbr-change-gnome-wallpaper"
TIMER = "voidbr-change-gnome-wallpaper-timer"
PASTA_PADRAO = "/usr/share/backgrounds/chililinux"
ESQUEMA_FUNDO = "org.gnome.desktop.background"

# mesmos valores do .conf distribuído no pacote
INTERVALO_PADRAO = 60
INTERVALO_FALLBACK = 300  # o timer usa 300 quando o INTERVAL é inválido

EXTENSOES = (".jpg", ".jpeg", ".png", ".webp", ".svg", ".bmp", ".jxl", ".avif")
MINI_L, MINI_A = 132, 74

# (rótulo, código)
MODOS = [("🎞️ Slideshow", "slide"), ("📌 Wallpaper fixo", "fixo"), ("⏸️ Desativado", "off")]
UNIDADES = [("segundos", 1), ("minutos", 60), ("horas", 3600)]

