# ---------------------------------------------------------------------------
# .conf
# ---------------------------------------------------------------------------

def normalizar_disabled(valor):
    """Mesma regra do voidbr-change-gnome-wallpaper-timer."""
    return "yes" if valor.strip().lower() in ("yes", "true", "1") else "no"


def tirar_aspas(bruto):
    """Valor como o bash enxergaria depois do '.' (aspas simples/duplas)."""
    try:
        partes = shlex.split(bruto, comments=True)
        return partes[0] if partes else ""
    except ValueError:
        return bruto.strip().strip("\"'")


def por_aspas(valor):
    """Valor seguro para o timer fazer '. arquivo.conf'."""
    if valor == "":
        return ""
    if re.fullmatch(r"[A-Za-z0-9_./+:@%,-]+", valor):
        return valor
    return "'" + valor.replace("'", "'\\''") + "'"


def ler_config():
    """Lê o .conf sem executá-lo (o timer usa '.', aqui só interpretamos)."""
    cfg = {"WALLPAPER_DIR": PASTA_PADRAO, "INTERVAL": INTERVALO_PADRAO,
           "DISABLED": "no", "FIXED_WALLPAPER": ""}
    linhas = []
    existe = os.path.isfile(CONFIG)
    if existe:
        with open(CONFIG, encoding="utf-8", errors="replace") as f:
            linhas = f.read().splitlines()
        for linha in linhas:
            m = re.match(r"^\s*(WALLPAPER_DIR|INTERVAL|DISABLED|FIXED_WALLPAPER)\s*=(.*)$", linha)
            if not m:
                continue
            chave, valor = m.group(1), tirar_aspas(m.group(2))
            if chave == "INTERVAL":
                cfg[chave] = int(valor) if valor.isdigit() and int(valor) > 0 else INTERVALO_FALLBACK
            elif chave == "DISABLED":
                cfg[chave] = normalizar_disabled(valor)
            elif chave == "WALLPAPER_DIR":
                # mesma regra do script: vazio usa a pasta padrão
                cfg[chave] = valor.rstrip("/") or PASTA_PADRAO
            else:
                cfg[chave] = valor
    return existe, cfg, linhas


def montar_config(linhas, cfg):
    """Troca só os valores das chaves, preservando comentários e linhas extras."""
    vistas, saida = set(), []
    for linha in linhas:
        m = re.match(r"^(\s*)(WALLPAPER_DIR|INTERVAL|DISABLED|FIXED_WALLPAPER)(\s*=).*$", linha)
        if m:
            chave = m.group(2)
            saida.append(f"{m.group(1)}{chave}{m.group(3)}{por_aspas(str(cfg[chave]))}")
            vistas.add(chave)
        else:
            saida.append(linha)
    for chave in CHAVES:
        if chave not in vistas:
            if saida and saida[-1].strip():
                saida.append("")
            saida.append(COMENTARIO[chave])
            saida.append(f"{chave}={por_aspas(str(cfg[chave]))}")
    return "\n".join(saida) + "\n"


def gravar_config(conteudo):
    """Grava num temporário e instala em /etc via pkexec. Devolve (código, erro)."""
    fd, tmp = tempfile.mkstemp(prefix="voidbr-cgw-", suffix=".conf")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(conteudo)
        os.chmod(tmp, 0o644)
        comando = ["install", "-m", "644", "-o", "root", "-g", "root", tmp, CONFIG]
        if os.geteuid() != 0:
            comando = ["pkexec"] + comando
        try:
            p = subprocess.run(comando, capture_output=True, text=True)
        except FileNotFoundError as e:
            return 127, str(e)
        return p.returncode, (p.stderr or p.stdout).strip()
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


# ---------------------------------------------------------------------------
# sistema
# ---------------------------------------------------------------------------

def listar_wallpapers(pasta):
    try:
        return sorted(e.path for e in os.scandir(pasta)
                      if e.is_file() and e.name.lower().endswith(EXTENSOES))
    except OSError:
        return []


def timer_rodando():
    p = subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", TIMER], capture_output=True)
    return p.returncode == 0


def intervalo_legivel(segundos):
    if segundos % 3600 == 0:
        n, u = segundos // 3600, "hora"
    elif segundos % 60 == 0:
        n, u = segundos // 60, "minuto"
    else:
        n, u = segundos, "segundo"
    return f"{n} {u}{'s' if n != 1 else ''}"


def melhor_unidade(segundos):
    for idx in (2, 1):
        if segundos % UNIDADES[idx][1] == 0:
            return idx, segundos // UNIDADES[idx][1]
    return 0, segundos


def textura_miniatura(caminho):
    """Carrega a imagem já reduzida e devolve uma textura para o Gtk.Picture.

    Gdk.Texture.new_for_pixbuf é obsoleto desde o GTK 4.20; o Gdk.MemoryTexture
    existe desde o GTK 4.0, então serve para todas as versões.
    """
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(caminho, MINI_L, MINI_A * 2, True)
    except GLib.Error:
        return None
    formato = Gdk.MemoryFormat.R8G8B8A8 if pb.get_has_alpha() else Gdk.MemoryFormat.R8G8B8
    stride = pb.get_rowstride()
    dados = pb.read_pixel_bytes().get_data()
    # o MemoryTexture exige stride * altura bytes; a última linha do pixbuf
    # pode vir sem o preenchimento final
    falta = stride * pb.get_height() - len(dados)
    if falta > 0:
        dados += bytes(falta)
    return Gdk.MemoryTexture.new(pb.get_width(), pb.get_height(), formato,
                                 GLib.Bytes.new(dados), stride)


