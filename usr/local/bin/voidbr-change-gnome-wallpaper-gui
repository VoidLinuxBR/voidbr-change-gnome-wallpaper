"""
voidbr-change-gnome-wallpaper-gui - Interface gráfica do voidbr-change-gnome-wallpaper.

Edita o /etc/voidbr-change-gnome-wallpaper.conf, que o
voidbr-change-gnome-wallpaper-timer relê a cada ciclo:
  - leitura do .conf, do gsettings e das miniaturas roda como o usuário;
  - gravação do .conf roda via pkexec.

Requer: PyGObject (GTK4), polkit e o voidbr-change-gnome-wallpaper.
    sudo xbps-install -S python3-gobject gtk4 polkit
"""

import ctypes
import os
import re
import shlex
import signal
import subprocess
import sys
import tempfile
from urllib.parse import unquote, urlparse


def configurar_renderizacao():
    """Usa o renderizador cairo (CPU) e desliga OpenGL/Vulkan no GDK.

    O app roda em máquinas e VMs de todo tipo: sem GPU, sem DRI3, sem driver
    Vulkan. Com OpenGL/Vulkan ligados o GDK testa os drivers ao abrir a tela e
    enche o terminal de avisos (Vulkan, MESA-EGL/DRI3). Para uma janela de
    configuração, o cairo é mais que suficiente e funciona em todo lugar.

    Precisa rodar ANTES do 'from gi.repository import Gtk', porque o import já
    abre a tela. Se o usuário definiu GSK_RENDERER, respeita a escolha dele.
    """
    if os.environ.get("GSK_RENDERER"):
        return
    os.environ["GSK_RENDERER"] = "cairo"
    # versão do GTK sem inicializá-lo: GDK_DISABLE existe a partir do 4.16;
    # antes era GDK_DEBUG=gl-disable (que no GTK novo gera aviso de valor desconhecido)
    try:
        menor = ctypes.CDLL("libgtk-4.so.1").gtk_get_minor_version()
    except (OSError, AttributeError):
        menor = 16
    if menor >= 16:
        os.environ.setdefault("GDK_DISABLE", "gl,vulkan")
    else:
        os.environ.setdefault("GDK_DEBUG", "gl-disable,vulkan-disable")


configurar_renderizacao()

