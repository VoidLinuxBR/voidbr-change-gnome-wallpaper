#
#  Uso (a GUI faz isso):
#    pkexec /usr/local/bin/voidbr-change-gnome-wallpaper-save-conf < novo.conf
#
#  O conteúdo novo chega pela entrada padrão. Antes de gravar, cada linha é
#  conferida: só passam comentários, linhas vazias e as chaves conhecidas com
#  valor simples ou entre aspas simples. O .conf é lido com '.' pelo timer de
#  cada usuário, então nada além disso pode entrar nele.
#
#  Saída: 0 = gravado; 1 = conteúdo recusado; 2 = erro ao gravar.

CONFIG=/etc/voidbr-change-gnome-wallpaper.conf
APP="${0##*/}"

if [ "$(id -u)" -ne 0 ]; then
	echo "${APP}: precisa rodar como root (use pkexec)" >&2
	exit 2
fi

tmp=$(mktemp "${CONFIG}.XXXXXX") || exit 2
trap 'rm -f "$tmp"' EXIT

# limite de 64 KiB: o .conf tem poucas linhas
head -c 65536 >"$tmp"

re_vazia='^[[:space:]]*(#.*)?$'
re_chave="^[[:space:]]*(WALLPAPER_DIR|INTERVAL|DISABLED|FIXED_WALLPAPER)=([A-Za-z0-9_./+:@%,-]*|'([^']|'\\\\'')*')$"

n=0
while IFS= read -r linha || [ -n "$linha" ]; do
	n=$((n + 1))
	if [[ $linha =~ $re_vazia ]] || [[ $linha =~ $re_chave ]]; then
		continue
	fi
	echo "${APP}: linha ${n} recusada: ${linha}" >&2
	exit 1
done <"$tmp"

chmod 644 "$tmp" && chown root:root "$tmp" || exit 2
# mv no mesmo sistema de arquivos: o timer nunca lê um .conf pela metade
mv -f "$tmp" "$CONFIG" || exit 2
trap - EXIT
exit 0
